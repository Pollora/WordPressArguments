{
    "name": "pollora/wordpress-args",
    "description": "Manipulate WordPress arguments as an object.",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\WordPressArgs\\": "src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.8.2",
        "spatie/invade": "^2.1",
        "laravel/pint": "^1.18",
        "pollora/harness": "^0.1.13"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    }
}
